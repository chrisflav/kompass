msgstr "Material angefragt"

msgid "Material request approved"
msgstr "Materialanfrage freigegeben"

msgid "Material request declined"
msgstr "Materialanfrage abgelehnt"

msgid "No answer before the start."
msgstr "Keine Antwort vor Beginn."

msgid "Please bring back material"
msgstr "Bitte Material zurückbringen"

msgid "Your material reservation starts tomorrow"
msgstr "Deine Materialreservierung beginnt morgen"

msgid "Material overdue"
msgstr "Material überfällig"

msgid "Material due tomorrow"
msgstr "Material morgen fällig"
