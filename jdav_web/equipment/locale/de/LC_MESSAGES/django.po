#, python-format
msgid "Only %(count)d of %(type)s are free in this period."
msgstr "Nur %(count)d × %(type)s sind in diesem Zeitraum frei."

#, python-format
msgid "%(part)s cannot be lent at the moment."
msgstr "%(part)s kann gerade nicht verliehen werden."

#, python-format
msgid "%(part)s is already booked in this period."
msgstr "%(part)s ist in diesem Zeitraum schon vergeben."

msgid "The end of the period lies before its start."
msgstr "Das Ende des Zeitraums liegt vor seinem Beginn."

msgid "The period lies in the past."
msgstr "Der Zeitraum liegt in der Vergangenheit."

msgid "Nothing was selected."
msgstr "Es wurde nichts ausgewählt."

msgid "This reservation is no longer waiting for a decision."
msgstr "Über diese Reservierung ist schon entschieden."

msgid "This group has nothing to decide on this reservation."
msgstr "Diese Gruppe hat über diese Reservierung nichts zu entscheiden."

msgid "Only an open reservation can be cancelled."
msgstr "Nur eine offene Reservierung kann storniert werden."

#, python-format
msgid "%(part)s is reserved by %(name)s from %(start)s to %(end)s."
msgstr "%(part)s ist von %(start)s bis %(end)s für %(name)s reserviert."

msgid "Only a confirmed reservation can be picked up."
msgstr "Nur eine bestätigte Reservierung kann abgeholt werden."

msgid "Counted material can only be lent with a return date."
msgstr "Gezähltes Material kann nur mit Rückgabedatum ausgeliehen werden."

msgid "Give a return date that is not in the past."
msgstr "Gib ein Rückgabedatum an, das nicht in der Vergangenheit liegt."

#, python-format
msgid "%(part)s is still lent to %(name)s."
msgstr "%(part)s ist noch an %(name)s verliehen."

msgid "Only a person can borrow material."
msgstr "Nur eine Person kann Material ausleihen."

msgid "Choose either a member or a location."
msgstr "Wähle entweder eine Person oder einen Ort."

#, python-format
msgid "%(part)s is reserved by %(name)s from %(start)s."
msgstr "%(part)s ist ab %(start)s für %(name)s reserviert."

msgid "A lent piece cannot be assembled."
msgstr "Ein verliehenes Teil kann nicht verbaut werden."

msgid "Material reserved"
msgstr "Material reserviert"

#, python-format
msgid "Material request for %(group)s"
msgstr "Materialanfrage für %(group)s"

