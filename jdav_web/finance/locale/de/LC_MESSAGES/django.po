msgstr "Engine-Version"

msgid "The Kompass and interpreter version the sources were imported into."
msgstr ""
"Die Kompass- und Interpreter-Version, in die die Quelltexte importiert "
"wurden."

msgid "Context version"
msgstr "Kontext-Version"

